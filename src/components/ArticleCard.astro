---
import type { Article } from '../lib/data';
import { getTopic } from '../lib/data';
import { formatDateTime } from '../lib/format';

interface Props { article: Article; showTopic?: boolean; size?: 'md' | 'sm' }
const { article: a, showTopic = false, size = 'md' } = Astro.props;
const topic = getTopic(a.topic);
---
<article class:list={['card', size]}>
  {showTopic && topic && <p class="label">{topic.name}</p>}
  <h3>
    <a href={a.sourceUrl} rel="noopener">{a.headline}<span class="ext" aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens {a.sourceName})</span></a>
  </h3>
  {size === 'md' && <p class="summary">{a.summary}</p>}
  <p class="meta">{a.sourceName} · <time datetime={a.publishedAt}>{formatDateTime(a.publishedAt)}</time></p>
</article>
<style>
  .card { display: grid; gap: var(--space-2); align-content: start; min-width: 0; }
  h3 { font-size: var(--text-xl); overflow-wrap: anywhere; }
  .sm h3 { font-size: var(--text-lg); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .ext { font-family: var(--font-body); font-size: 0.7em; color: var(--color-text-muted); }
  .summary { color: var(--color-text); max-width: var(--measure); }
</style>
