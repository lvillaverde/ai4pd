---
import type { Article } from '../lib/data';
import { getTopic } from '../lib/data';
import { formatDateTime } from '../lib/format';
import { storyUrl } from '../lib/url';
import Thumb from './Thumb.astro';

interface Props {
  article: Article;
  /** Edition date, used to build the story page link. */
  date: string;
  showTopic?: boolean;
  /** lg: beside the lead · md: default grid card · sm: dense grids · list: headline + meta only */
  size?: 'lg' | 'md' | 'sm' | 'list';
  /** Single story in a row: text and image side by side on wide screens. */
  wide?: boolean;
}
const { article: a, date, showTopic = false, size = 'md', wide = false } = Astro.props;
const topic = getTopic(a.topic);
const href = storyUrl(date, a.id);
---
<article class:list={['card', size, { wide }]}>
  <div class="text">
    {showTopic && topic && <p class="label">{topic.name}</p>}
    <h3><a href={href}>{a.headline}</a></h3>
    <p class="meta"><strong>{a.sourceName}</strong> · <time datetime={a.publishedAt}>{formatDateTime(a.publishedAt)}</time></p>
  </div>
  {size !== 'list' && <Thumb article={a} href={href} />}
  {size !== 'list' && <p class="deck">{a.excerpt}</p>}
</article>
<style>
  .card {
    display: grid; gap: var(--space-4); align-content: start; min-width: 0;
    padding-bottom: var(--space-5); border-bottom: var(--rule-width) solid var(--color-rule);
  }
  .text { display: grid; gap: var(--space-2); align-content: start; }
  h3 { font-size: var(--text-xl); line-height: var(--leading-snug); overflow-wrap: anywhere; }
  .lg h3 { font-size: var(--text-2xl); }
  .sm h3, .list h3 { font-size: var(--text-lg); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; }
  .deck { font-size: var(--text-base); max-width: var(--measure); }
  .list { padding-bottom: 0; border-bottom: 0; }
  @media (min-width: 48rem) {
    .wide {
      grid-template-columns: 1fr 1fr; grid-template-areas: 'text thumb' 'deck thumb';
      grid-template-rows: auto 1fr; gap: var(--space-4) var(--grid-gap);
    }
    .wide .text { grid-area: text; }
    .wide .deck { grid-area: deck; font-size: var(--text-lg); }
    .wide :global(.thumb) { grid-area: thumb; }
    .wide h3 { font-size: var(--text-2xl); }
  }
</style>
