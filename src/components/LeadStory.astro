---
import type { Article } from '../lib/data';
import { getTopic } from '../lib/data';
import { formatDateTime } from '../lib/format';
import { storyUrl } from '../lib/url';
import Thumb from './Thumb.astro';

interface Props { article: Article; date: string }
const { article: a, date } = Astro.props;
const topic = getTopic(a.topic);
const href = storyUrl(date, a.id);
---
<article class="lead">
  <div class="body">
    {topic && <p class="label">{topic.name}</p>}
    <h2><a href={href}>{a.headline}</a></h2>
    <p class="deck summary">{a.excerpt}</p>
    <p class="meta"><strong>{a.sourceName}</strong> · <time datetime={a.publishedAt}>{formatDateTime(a.publishedAt)}</time></p>
  </div>
  <Thumb article={a} href={href} eager />
</article>
<style>
  .lead { display: grid; gap: var(--space-5); align-content: start; min-width: 0; }
  .body { display: grid; gap: var(--space-3); }
  h2 { font-size: var(--text-3xl); overflow-wrap: anywhere; }
  h2 a { text-decoration: none; }
  h2 a:hover { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; }
  .summary { font-size: var(--text-lg); max-width: var(--measure); }
</style>
