---
import { siteConfig } from '../site.config';
import { topics } from '../lib/data';
import { formatLongDate } from '../lib/format';
import { url } from '../lib/url';

interface Props { activeTopic?: string; editionDate?: string }
const { activeTopic, editionDate } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === url('/').replace(/\/$/, '');
const isArchive = path === url('/archive');
---
<header class="masthead">
  <div class="container">
    <div class="top meta">
      <span>{editionDate ? formatLongDate(editionDate) : siteConfig.tagline}</span>
      <a href={url('/rss.xml')}>RSS</a>
    </div>
    <a class="brand" href={url('/')} aria-current={isHome ? 'page' : undefined}>{siteConfig.title}</a>
    <p class="tagline">{siteConfig.tagline}</p>
  </div>
  <nav class="nav" aria-label="Sections">
    <ul class="container">
      <li><a href={url('/')} aria-current={isHome ? 'page' : undefined}>Today</a></li>
      {topics.map((t) => (
        <li><a href={url(`/topic/${t.slug}/`)} aria-current={activeTopic === t.slug ? 'page' : undefined}>{t.name}</a></li>
      ))}
      <li><a href={url('/archive/')} aria-current={isArchive ? 'page' : undefined}>Archive</a></li>
    </ul>
  </nav>
</header>

<style>
  .masthead { text-align: center; padding-top: var(--space-4); }
  .top { display: flex; justify-content: space-between; gap: var(--space-4); padding-bottom: var(--space-3); border-bottom: var(--rule-width) solid var(--color-rule); }
  .top a { text-decoration: none; }
  .brand {
    display: inline-block; margin-top: var(--space-5);
    font-family: var(--font-display); font-size: var(--text-masthead); font-weight: var(--weight-medium);
    line-height: 1; letter-spacing: -0.02em; text-decoration: none;
  }
  .tagline { margin: var(--space-2) 0 var(--space-5); color: var(--color-text-muted); font-family: var(--font-display); font-style: italic; font-size: var(--text-lg); }
  .nav { border-block: var(--rule-width) solid var(--color-rule-strong); }
  .nav ul {
    list-style: none; display: flex; gap: var(--space-5); justify-content: center;
    overflow-x: auto; scrollbar-width: none; padding-block: var(--space-3);
  }
  .nav ul::-webkit-scrollbar { display: none; }
  .nav a { font-size: var(--text-sm); font-weight: var(--weight-medium); text-decoration: none; white-space: nowrap; padding-block: var(--space-1); }
  .nav a[aria-current='page'] { color: var(--color-accent); box-shadow: inset 0 -2px 0 currentColor; }
  @media (max-width: 48rem) { .nav ul { justify-content: flex-start; } }
</style>
