---
import type { Article } from '../lib/data';
import { getTopic } from '../lib/data';

interface Props { article: Article; eager?: boolean; href?: string; caption?: boolean }
const { article: a, eager = false, href, caption = false } = Astro.props;
const Wrap = href ? 'a' : 'div';
---
<figure class="thumb">
  <Wrap class="frame" href={href} tabindex={href ? -1 : undefined} aria-hidden={href ? 'true' : undefined}>
    <img
      src={a.imageUrl}
      alt={href ? '' : a.imageAlt}
      width="1200"
      height="675"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="this.closest('.thumb').classList.add('failed')"
    />
    <!-- Shown only if the publisher blocks the image, so every story keeps a picture. -->
    <span class="fallback" aria-hidden="true">
      <span class="fb-topic">{getTopic(a.topic)?.name}</span>
      <span class="fb-source">{a.sourceName}</span>
    </span>
  </Wrap>
  {caption && <figcaption>{a.imageAlt}. <span>Image: {a.sourceName}</span></figcaption>}
</figure>
<style>
  .frame { display: block; position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--color-surface); }
  img { width: 100%; height: 100%; object-fit: cover; }
  a.frame img { transition: transform 300ms ease; }
  a.frame:hover img { transform: scale(1.02); }
  .fallback {
    position: absolute; inset: 0; display: none; flex-direction: column; justify-content: flex-end; gap: var(--space-1);
    padding: var(--space-4); color: #fff;
    background: linear-gradient(135deg, var(--color-brand), var(--color-accent) 60%, #1f1f1f);
  }
  .failed img { display: none; }
  .failed .fallback { display: flex; }
  .fb-topic { font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); text-transform: uppercase; opacity: 0.85; }
  .fb-source { font-size: var(--text-xl); font-weight: var(--weight-bold); line-height: var(--leading-tight); }
  figcaption { margin-top: var(--space-2); font-size: var(--text-sm); font-weight: var(--weight-light); color: var(--color-text-muted); }
  figcaption span { white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { a.frame img { transition: none; } }
</style>
