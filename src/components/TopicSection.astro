---
import StoryGrid from './StoryGrid.astro';
import TopicIcon from './TopicIcon.astro';
import type { Article, Topic } from '../lib/data';
import { url } from '../lib/url';

interface Props { topic: Topic; articles: Article[]; date: string; hideWhenEmpty?: boolean }
const { topic, articles, date, hideWhenEmpty = false } = Astro.props;
const headingId = `section-${topic.slug}`;
---
{!(hideWhenEmpty && articles.length === 0) && (
  <section class="topic" aria-labelledby={headingId}>
    <div class="section-head">
      <h2 id={headingId}><TopicIcon name={topic.icon} size={22} />{topic.name}</h2>
      <a href={url(`/topic/${topic.slug}/`)}>More {topic.name}<span aria-hidden="true"> →</span></a>
    </div>
    {articles.length ? (
      <StoryGrid articles={articles} date={date} />
    ) : (
      <p class="empty">No stories today.</p>
    )}
  </section>
)}
<style>
  .topic { margin-bottom: var(--space-7); }
</style>
