---
import { siteConfig } from '../site.config';
import { formatLongDate } from '../lib/format';

interface Props { date: string }
const { date } = Astro.props;
---
<div class="edition-note" data-edition-date={date} data-tz={siteConfig.timezone}>
  <p class="stale" hidden>Today's edition isn't out yet — showing news from {formatLongDate(date)}.</p>
</div>
<script is:inline>
  (function () {
    var el = document.currentScript.previousElementSibling;
    try {
      var today = new Intl.DateTimeFormat('en-CA', { timeZone: el.dataset.tz }).format(new Date());
      if (today !== el.dataset.editionDate) el.querySelector('.stale').hidden = false;
    } catch (e) {}
  })();
</script>
<style>
  .stale { margin-bottom: var(--space-5); background: var(--color-note-bg); padding: var(--space-2) var(--space-3); font-size: var(--text-sm); border-left: var(--rule-width-strong) solid var(--color-accent); }
</style>
