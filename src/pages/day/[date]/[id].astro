---
import Base from '../../../layouts/Base.astro';
import Thumb from '../../../components/Thumb.astro';
import StoryGrid from '../../../components/StoryGrid.astro';
import { getEditions, getTopic, type Article, type Edition } from '../../../lib/data';
import { formatLongDate, formatPublished, formatShortDate } from '../../../lib/format';
import { url, storyUrl, domainOf } from '../../../lib/url';
import { siteConfig } from '../../../site.config';

export async function getStaticPaths() {
  const editions = await getEditions();
  return editions.flatMap((edition) =>
    edition.articles.map((article, i) => ({
      params: { date: edition.date, id: article.id },
      props: { edition, article, prev: edition.articles[i - 1], next: edition.articles[i + 1] },
    })),
  );
}

interface Props { edition: Edition; article: Article; prev?: Article; next?: Article }
const { edition, article: a, prev, next } = Astro.props;
const topic = getTopic(a.topic);
const topicHref = url(`/topic/${a.topic}/`);
const dayHref = url(`/day/${edition.date}/`);
const whyLabel = siteConfig.whyItMattersLabel[a.topic] ?? siteConfig.whyItMattersLabel.default;
// Same-topic stories first, then the rest of the edition.
const others = edition.articles.filter((o) => o !== a);
const related = [...others.filter((o) => o.topic === a.topic), ...others.filter((o) => o.topic !== a.topic)].slice(0, 3);
---
<Base
  edition={edition}
  title={a.headline}
  description={a.excerpt}
  activeTopic={a.topic}
  image={{ url: a.imageUrl, alt: a.imageAlt }}
  ogType="article"
>
  <nav class="crumbs meta" aria-label="Breadcrumb">
    <ol>
      <li><a href={dayHref}>{formatShortDate(edition.date)} edition</a></li>
      {topic && <li><a href={topicHref}>{topic.name}</a></li>}
    </ol>
  </nav>

  <article class="story">
    <header class="story-head">
      {topic && <p class="label"><a href={topicHref}>{topic.name}</a></p>}
      <h1>{a.headline}</h1>
      <p class="standfirst">{a.excerpt}</p>
      <p class="meta byline">
        {a.author && <>By <strong>{a.author}</strong> · </>}<strong>{a.sourceName}</strong> · <time datetime={a.publishedAt}>{formatPublished(a.publishedAt)}</time>
      </p>
    </header>

    <div class="story-body">
      <div class="main">
        <Thumb article={a} eager caption />

        <div class="summary">
          <h2 class="visually-hidden">Summary</h2>
          {a.summary.map((p) => <p>{p}</p>)}
        </div>

        {a.whyItMatters && (
          <aside class="why" aria-label={whyLabel}>
            <p class="label">{whyLabel}</p>
            <p>{a.whyItMatters}</p>
          </aside>
        )}

        <p><a class="cta" href={a.sourceUrl} target="_blank" rel="noopener noreferrer">Read the full article on {a.sourceName}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></p>
        <p class="meta note">This is an original summary written by an AI agent. Facts, figures and quotes come from {a.sourceName}; check the full article before citing them.</p>
      </div>

      <aside class="facts" aria-label="About this story">
        <dl>
          <div><dt>Source</dt><dd><a href={a.sourceUrl} target="_blank" rel="noopener noreferrer">{a.sourceName}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a> <span class="domain">{domainOf(a.sourceUrl)}</span></dd></div>
          {a.author && <div><dt>Author</dt><dd>{a.author}</dd></div>}
          <div><dt>Published</dt><dd><time datetime={a.publishedAt}>{formatPublished(a.publishedAt)}</time></dd></div>
          {topic && <div><dt>Topic</dt><dd><a href={topicHref}>{topic.name}</a></dd></div>}
          <div><dt>Edition</dt><dd><a href={dayHref}>{formatLongDate(edition.date)}</a></dd></div>
          {a.tags && a.tags.length > 0 && (
            <div><dt>Tags</dt><dd><ul class="tags">{a.tags.map((t) => <li>{t}</li>)}</ul></dd></div>
          )}
        </dl>
        <button class="copy" type="button" hidden>Copy link</button>
      </aside>
    </div>
  </article>

  <nav class="pager" aria-label="Stories in this edition">
    {prev ? <a href={storyUrl(edition.date, prev.id)} rel="prev"><span class="meta">← Previous</span>{prev.headline}</a> : <span />}
    {next ? <a class="next" href={storyUrl(edition.date, next.id)} rel="next"><span class="meta">Next →</span>{next.headline}</a> : <span />}
  </nav>

  {related.length > 0 && (
    <section class="more" aria-labelledby="more">
      <div class="section-head">
        <h2 id="more">More from this edition</h2>
        <a href={dayHref}>All {edition.articles.length} stories<span aria-hidden="true"> →</span></a>
      </div>
      <StoryGrid articles={related} date={edition.date} showTopic />
    </section>
  )}
</Base>

<script is:inline>
  (function () {
    var btn = document.querySelector('.facts .copy');
    if (!btn || !navigator.clipboard) return;
    btn.hidden = false;
    btn.addEventListener('click', function () {
      navigator.clipboard.writeText(location.href).then(function () {
        btn.textContent = 'Link copied';
        setTimeout(function () { btn.textContent = 'Copy link'; }, 2000);
      });
    });
  })();
</script>

<style>
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .crumbs li + li::before { content: '›'; margin-right: var(--space-2); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .story-head { display: grid; gap: var(--space-3); margin-block: var(--space-5) var(--space-6); max-width: 52rem; }
  .story-head .label a { text-decoration: none; color: inherit; }
  h1 { font-size: var(--text-3xl); overflow-wrap: anywhere; }
  .standfirst { font-size: var(--text-lg); font-weight: var(--weight-light); line-height: var(--leading-normal); max-width: var(--measure); }

  .story-body { display: grid; gap: var(--space-6) var(--space-7); }
  @media (min-width: 64rem) { .story-body { grid-template-columns: minmax(0, 1fr) 18rem; } }
  .main { display: grid; gap: var(--space-5); align-content: start; min-width: 0; }

  .summary { display: grid; gap: var(--space-4); max-width: var(--measure); }
  .summary p { font-size: var(--text-lg); line-height: 1.65; }

  .why {
    max-width: var(--measure); padding: var(--space-4) var(--space-5); display: grid; gap: var(--space-2);
    background: var(--color-note-bg); border-left: 3px solid var(--color-brand); border-radius: 0 var(--radius) var(--radius) 0;
  }
  .why p:last-child { font-size: var(--text-lg); }

  .cta {
    display: inline-flex; align-items: center; gap: var(--space-1);
    padding: var(--space-3) var(--space-5); border-radius: 999px;
    background: var(--color-accent); color: var(--color-accent-contrast);
    font-weight: var(--weight-medium); text-decoration: none;
  }
  .cta:hover { color: var(--color-accent-contrast); filter: brightness(1.08); }
  .note { max-width: var(--measure); }

  .facts { align-self: start; display: grid; gap: var(--space-4); border-top: var(--rule-width) solid var(--color-rule); padding-top: var(--space-4); }
  @media (min-width: 64rem) { .facts { position: sticky; top: 5rem; } }
  dl { display: grid; gap: var(--space-3); }
  dl div { display: grid; gap: var(--space-1); padding-bottom: var(--space-3); border-bottom: var(--rule-width) solid var(--color-rule); }
  dt { font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-text-muted); }
  dd { margin: 0; font-size: var(--text-sm); overflow-wrap: anywhere; }
  .domain { display: block; color: var(--color-text-muted); font-weight: var(--weight-light); }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tags li { padding: 0.125rem var(--space-2); border: var(--rule-width) solid var(--color-rule); border-radius: 999px; font-size: var(--text-xs); }
  .copy {
    justify-self: start; font: inherit; font-size: var(--text-sm); font-weight: var(--weight-medium); cursor: pointer;
    padding: var(--space-2) var(--space-4); border-radius: 999px;
    border: var(--rule-width) solid var(--color-rule-strong); background: transparent; color: var(--color-text);
  }
  .copy:hover { background: var(--color-surface); }

  .pager {
    display: grid; gap: var(--space-4); margin-block: var(--space-7);
    padding-block: var(--space-5); border-block: var(--rule-width) solid var(--color-rule);
  }
  @media (min-width: 48rem) { .pager { grid-template-columns: 1fr 1fr; } }
  .pager a { display: grid; gap: var(--space-1); font-weight: var(--weight-bold); text-decoration: none; }
  .pager a:hover { text-decoration: underline; }
  .pager .next { text-align: right; }
</style>
