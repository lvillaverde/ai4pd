{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topics.schema.json",
  "title": "Topics",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "icon": { "enum": ["bot", "cursor", "target", "pen", "newspaper", "hash"], "description": "Section icon (src/components/TopicIcon.astro). Defaults to hash." },
          "description": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
