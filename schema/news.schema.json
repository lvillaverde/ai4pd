{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news.schema.json",
  "title": "Daily edition",
  "description": "One file per day at data/news/YYYY-MM-DD.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "generatedAt", "articles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "type": "string", "format": "date" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "articles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/article" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "headline", "summary", "sourceName", "sourceUrl", "publishedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100 },
        "topic": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "headline": { "type": "string", "minLength": 5, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 20, "maxLength": 1200 },
        "sourceName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "featured": { "type": "boolean" },
        "imageUrl": { "$ref": "#/$defs/httpsUrl" },
        "imageAlt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 30 }
        }
      },
      "dependentRequired": { "imageUrl": ["imageAlt"] }
    }
  }
}
