{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news.schema.json",
  "title": "Daily edition",
  "description": "One file per day at data/news/YYYY-MM-DD.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "date",
    "generatedAt",
    "articles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/article"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "headline",
        "excerpt",
        "summary",
        "sourceName",
        "sourceUrl",
        "publishedAt",
        "imageUrl",
        "imageAlt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 100
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "headline": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "excerpt": {
          "type": "string",
          "minLength": 30,
          "maxLength": 160,
          "description": "One short sentence shown under the headline on the homepage and in lists."
        },
        "summary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Exactly two paragraphs, in your own words, shown on the story page.",
          "items": {
            "type": "string",
            "minLength": 150,
            "maxLength": 900
          }
        },
        "whyItMatters": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400,
          "description": "Optional one-sentence takeaway for product designers, without a label prefix. Never name a specific employer or product the reader works on."
        },
        "sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "featured": {
          "type": "boolean"
        },
        "imageUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "imageAlt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        }
      }
    }
  }
}
